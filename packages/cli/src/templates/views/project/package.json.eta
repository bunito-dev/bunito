{
  "name": "<%= it.name %>",
  "private": true,
  "type": "module",
  "scripts": {
    "cli": "bunito",
    "sync": "bunito sync",
    "start": "bunito start",
    "build": "bunito build",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "lint": "biome check",
    "format": "biome format",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bunito/bunito": "<%~ it.bunitoVersion %>"
  },
  "devDependencies": {
    "@biomejs/biome": "<%~ it.biomeVersion %>",
    "@bunito/cli": "<%~ it.bunitoVersion %>",
    "@bunito/testing": "<%~ it.bunitoVersion %>",
    "@types/bun": "<%~ it.bunTypesVersion %>",
    "typescript": "<%~ it.typescriptVersion %>"
  },
  "engines": {
    "bun": "<%~ it.bunEngineVersion %>"
  }
}
