{
  "name": "@bunito/cli",
  "version": "0.0.25",
  "description": "Command-line tools for initializing, generating, running, and building bunito projects.",
  "keywords": [
    "bunito",
    "cli",
    "bun",
    "scaffold",
    "workspace",
    "framework"
  ],
  "author": "Stanisław Głogowski <hello@bunito.dev>",
  "license": "MIT",
  "homepage": "https://bunito.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/bunito-dev/bunito.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/bunito-dev/bunito/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "bunito": "./src/main.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {},
  "dependencies": {
    "@bunito/app": "workspace:0.0.25",
    "@bunito/common": "workspace:0.0.25",
    "@bunito/config": "workspace:0.0.25",
    "@bunito/container": "workspace:0.0.25",
    "@bunito/logger": "workspace:0.0.25",
    "@inquirer/prompts": "8.5.2",
    "eta": "4.6.0",
    "yargs": "18.0.0"
  },
  "devDependencies": {
    "@bunito/testing": "workspace:0.0.25",
    "@types/yargs": "17.0.35"
  },
  "engines": {
    "bun": ">=1.3.10"
  }
}