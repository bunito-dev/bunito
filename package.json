{
  "name": "bunito",
  "private": true,
  "version": "0.0.21",
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "bun test",
    "coverage": "bun run test --coverage",
    "lint": "biome check",
    "format": "biome format",
    "typecheck": "tsc --noEmit",
    "publish-all": "for dir in packages/*; do (cd \"$dir\" && bun publish); done",
    "sync-versions": "bun scripts/sync-versions.ts"
  },
  "workspaces": {
    "packages": ["examples/*", "packages/*"],
    "catalog": {
      "@nats-io/transport-node": "3.4.0",
      "zod": "4.4.3"
    },
    "catalogs": {
      "range": {
        "@nats-io/transport-node": "^3.4.0",
        "zod": "^4.4.0"
      }
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/bun": "^1.3.0",
    "typescript": "^6.0.0",
    "vitepress": "^1.6.0"
  },
  "engines": {
    "bun": ">=1.3.10"
  }
}
